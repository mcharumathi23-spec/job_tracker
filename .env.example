# ==============================================================================
# Mini JobTrack - Environment Variables Configuration Template
# ==============================================================================
# Copy this file to '.env' or export these environment variables before running.
# DO NOT commit real secrets or credentials into version control.

# ------------------------------------------------------------------------------
# Backend Configuration (Spring Boot)
# ------------------------------------------------------------------------------
PORT=8080

# MySQL Database Connection
# URL formatted as: jdbc:mysql://<host>:<port>/<database_name>
DB_URL=jdbc:mysql://localhost:3306/jobtrack_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=postgres
DB_PASSWORD=1234

# JWT Authentication Secret & Expiration (24h)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite + React)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api
